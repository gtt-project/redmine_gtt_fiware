<div class="box tabular">
  <%# required/id must be in html_options (4th arg) -- in the 3rd (options)
      hash Rails silently drops them, the select gets the default id, and the
      LD oneshot toggle in _form_script never finds it. %>
  <p class="min-width"><%= f.select :status, SubscriptionTemplate::STATUS, {}, required: true, id: 'gtt-fiware-status-select' %>
    <em class="info js-ngsi-ld-only" style="display: none;"><%= l(:text_status_oneshot_ld_info) %></em></p>

  <p>
    <%= f.label :expires, l(:field_subscription_template_expiration) %>
    <%= f.datetime_select :expires, include_blank: true %>
  </p>

  <%# Subscription-level @context override; the connection's context is the default. LD only. %>
  <p class="js-ngsi-ld-only"><%= f.text_field :context, size: 75, placeholder: l(:field_subscription_template_context_placeholder) %>
    <em class="info"><%= l(:text_context_override_info) %></em></p>

  <p><%= f.number_field :throttling, min: 0, step: 1, label: :field_subscription_template_throttling %>
    <em class="info"><%= l(:text_subscription_template_throttling_info) %></em></p>

  <%# Federation awareness (#70, 4a): what to do when another organization
      already has a work order for the notifying entity. %>
  <p class="min-width"><%= f.select :federation_policy,
        SubscriptionTemplate::FEDERATION_POLICIES.map { |p| [l(:"label_federation_policy_#{p}"), p] } %>
    <em class="info"><%= l(:text_federation_policy_info) %></em></p>

  <%# Federation watch (#70, 4c): this subscription observes other
      organizations' work orders instead of creating issues. %>
  <p class="js-ngsi-ld-only"><%= f.check_box :federation_watch %>
    <em class="info"><%= l(:text_federation_watch_info) %></em></p>

  <p><%= f.text_field :subscription_id, size: 75, placeholder: l(:field_subscription_template_subscription_placeholder) %></p>

  <p><%= f.text_area :comment, placeholder: l(:field_subscription_template_comment_placeholder) %></p>
</div>
