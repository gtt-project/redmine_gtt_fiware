<%
  project_boundary_available = gtt_fiware_project_boundary_available?(@project)
  geo_mode = gtt_fiware_geo_mode(@subscription_template, project_boundary_available)
%>

<div class="box tabular">
  <%# Comma-separated watched attributes; serialized into the attrs JSON array. %>
  <p>
    <%= content_tag :label, l(:field_subscription_template_watched_attributes), for: 'gtt-fiware-attrs-input' %>
    <input type="text" id="gtt-fiware-attrs-input" size="75" value="<%= gtt_fiware_watched_attrs_list(@subscription_template) %>" placeholder="<%= l(:field_subscription_template_watched_attrs_placeholder) %>" />
    <em class="info"><%= l(:text_watched_attributes_info) %></em>
  </p>
  <%= f.hidden_field :attrs %>

  <p><%= f.text_field :expression_query, size: 75, placeholder: l(:field_subscription_template_expression_query_placeholder) %></p>

  <p>
    <%= content_tag :label, l(:field_subscription_template_geo_area) %>
    <label class="inline"><input type="radio" name="gtt_fiware_geo_mode" value="anywhere" <%= 'checked' if geo_mode == 'anywhere' %> /> <%= l(:label_geo_area_anywhere) %></label>
    <% if project_boundary_available %>
      <label class="inline"><input type="radio" name="gtt_fiware_geo_mode" value="boundary" <%= 'checked' if geo_mode == 'boundary' %> data-geom="<%= @project.geojson.to_json %>" /> <%= l(:label_geo_area_boundary) %></label>
    <% end %>
    <label class="inline"><input type="radio" name="gtt_fiware_geo_mode" value="custom" <%= 'checked' if geo_mode == 'custom' %> /> <%= l(:label_geo_area_custom) %></label>
  </p>

  <%# Boundary crossing notes (#87): plugin-side, so it works precisely when
      the broker is NOT geo-filtering (a geo-filtered broker simply stops
      notifying, and a leave can never be observed). %>
  <p>
    <%= f.check_box :geofence_notes, disabled: !project_boundary_available %>
    <em class="info">
      <%= project_boundary_available ? l(:text_geofence_notes_info) : l(:text_geofence_notes_unavailable) %>
    </em>
  </p>

  <span id="gtt-fiware-geo-custom" <%= 'style=display:none;'.html_safe unless geo_mode == 'custom' %>>
    <p><%= f.text_field :expression_georel, size: 75, placeholder: l(:field_subscription_template_expression_georel_placeholder) %></p>
    <p class="min-width"><%= f.select :expression_geometry, SubscriptionTemplate::GEOMETRIES, include_blank: true %></p>
    <p><%= f.text_field :expression_coords, size: 75, placeholder: l(:field_subscription_template_expression_coords_placeholder) %></p>
  </span>

  <p>
    <%= content_tag :label, l(:field_subscription_template_alteration_types) %>
    <% SubscriptionTemplate::ALTERATION_TYPES.each do |type| %>
      <span class="js-alteration-choice" data-type="<%= type %>">
        <%= check_box_tag 'subscription_template[alteration_types][]', type,
            @subscription_template.alteration_types&.include?(type), id: nil %>
        <code class="js-alteration-label" data-v2="<%= type %>" data-ld="<%= SubscriptionTemplate::NGSI_LD_TRIGGER_MAP[type] %>"><%= type %></code>
      </span>
    <% end %>
    <em class="info js-ngsi-ld-only" style="display: none;"><%= l(:text_alteration_types_ld_info) %></em>
  </p>

  <p class="js-ngsi-v2-only"><%= f.check_box :notify_on_metadata_change, default: true %></p>
</div>
